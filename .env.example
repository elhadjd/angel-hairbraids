NEXT_PUBLIC_SITE_URL=https://angelafricanhairbraiding.com
# Origin only — do NOT append /api/site.
# JSON:   {SITE_API_HOST}/api/site/products
# Images: {SITE_API_HOST}/produtos/image/{id}/{file}
# Good:  http://localhost:8080
# Bad:   http://localhost:8080/api/site
SITE_API_HOST=http://localhost:8080
# Quote the key. It often contains +, /, and =.
SITE_API_KEY="SUA_CHAVE_API"
# Optional: Stripe deposit amount (requires success/cancel URLs; omit for no deposit)
# SITE_API_DEPOSIT_AMOUNT=15
# Optional: send real confirmation emails
# RESEND_API_KEY=re_xxxxxxxxx
# EMAIL_FROM=Angel African Hair Braiding <angelddie@yahoo.com>
